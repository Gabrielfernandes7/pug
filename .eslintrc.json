{
  "env": {
    "node": true,
    "es6": true,
    "jest": true
  },
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "script"
  },
  "rules": {
    "no-console": "warn",
    "no-unused-vars": "warn",
    "semi": ["warn", "always"],
    "quotes": ["warn", "single"],
    "comma-dangle": "off",
    "no-var": "off",
    "prefer-const": "warn"
  },
  "overrides": [
    {
      "files": ["**/test/**"],
      "rules": {
        "no-unused-expressions": "off"
      }
    }
  ]
}
